{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "checkJs": false,
    "resolveJsonModule": true,
    "paths": {
      "@core/*": ["src/js/core/*"],
      "@features/*": ["src/js/features/*"],
      "@pages/*": ["src/js/pages/*"],
      "@locales/*": ["src/locales/*"],
      "@css/*": ["src/css/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
