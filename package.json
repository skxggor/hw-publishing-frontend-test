{
  "name": "hw-publishing-frontend-test",
  "version": "1.0.0",
  "description": "Case técnico frontend para H&W Publishing - Fluxo de vendas digital",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/js/",
    "lint:fix": "eslint src/js/ --fix",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:css:fix": "stylelint \"src/css/**/*.css\" --fix",
    "format": "prettier --write \"src/**/*.{js,css,json}\" \"tests/**/*.js\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css,json}\" \"tests/**/*.js\" \"*.config.js\"",
    "check": "npm run lint && npm run lint:css && npm run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/js/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/css/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "tests/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/locales/**/*.json": [
      "prettier --write"
    ]
  },
  "keywords": [
    "frontend",
    "test",
    "sales-funnel",
    "vanilla-js"
  ],
  "author": "Marcos Lima",
  "license": "MIT",
  "dependencies": {
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.1.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.10"
  }
}
